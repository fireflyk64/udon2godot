; udon2godot world project template: converted UdonSharp scripts run in the godot-sandbox, scenes
; are imported by unidot_importer with the udon_integration plugin.
config_version=5

[application]

config/name="udon2godot_world"
config/features=PackedStringArray("4.7")

[autoload]

Udon="*res://addons/udon_runtime/udon.gd"
U="*res://addons/udon_runtime/u.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_sandbox/plugin.cfg", "res://addons/unidot_importer/plugin.cfg", "res://addons/unidot_importer/headless/plugin.cfg")

[physics]

3d/default_gravity=9.81
; imported worlds carry scaled colliders (a unit box under a (10, 1, 10) node): Godot Physics
; handles them as tested; Jolt (Godot 4.7's default) let a CharacterBody3D fall through such a floor
3d/physics_engine="GodotPhysics3D"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[udon]

coord_mode="unidot"
manifest="res://converted/udon_manifest.json"
import_report="res://udon_import_report.json"

[unidot]

extra_plugins=PackedStringArray("res://addons/unidot_importer/udon_integration.gd")
shader_ports=PackedStringArray("res://addons/udon_runtime/shader_ports")

[sandbox]

compilation/debug_info=true
